# MongoDB Atlas connection string. The database name goes before the "?".
# Prisma needs a replica set (Atlas has one by default; a plain local mongod does not).
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/la-tickets?retryWrites=true&w=majority"

# Random secret used to derive ticket QR codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=""

# Protects /api/cron/expire-holds (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# Stripe (test mode keys). Leave empty in development to confirm orders without payment.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=""

# Public URL of the site, used for Stripe redirects. Optional locally.
APP_URL="http://localhost:3000"

# Ticketmaster Discovery API key (free: https://developer.ticketmaster.com) for `npm run tm:sync`.
TICKETMASTER_API_KEY=""
# What to import from Ticketmaster (artist, team, venue...).
TICKETMASTER_KEYWORD="Post Malone"
